default_platform(:ios)

opt_out_usage

platform :ios do
  desc "Build and upload iOS app to App Store Connect"
  lane :release do
    key_content = ENV["APP_STORE_PRIVATE_KEY"]
    
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: key_content,
      is_key_content_base64: false
    )

    create_keychain(
      name: "build_keychain",
      password: "temporary_password_123",
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    raw_path = lane_context[SharedValues::KEYCHAIN_PATH] || "~/Library/Keychains/build_keychain"
    expanded_path = File.expand_path(raw_path)
    kc_path = File.exist?(expanded_path) ? expanded_path : "#{expanded_path}-db"

    UI.message("Using keychain path: #{kc_path}")

    begin
      require 'spaceship'
      Spaceship::ConnectAPI::Certificate.all.each do |c|
        if c.certificate_type.to_s.include?("DISTRIBUTION")
          UI.message("Cleaning up previous ephemeral CI certificate: #{c.id} (#{c.certificate_type})")
          c.delete!
        end
      end
    rescue => ex
      UI.message("Note during certificate cleanup: #{ex.message}")
    end

    get_certificates(
      api_key: api_key,
      keychain_path: kc_path,
      keychain_password: "temporary_password_123",
      force: true
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.waterpolo.tacticalboard",
      force: true
    )

    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    plist_xml = sh("security cms -D -i \"#{profile_path}\"", log: false)
    team_match = plist_xml.match(/<key>TeamIdentifier<\/key>\s*<array>\s*<string>([A-Z0-9]+)<\/string>/)
    team_id = team_match ? team_match[1] : ""
    UI.message("Detected Apple Developer Team ID: #{team_id}")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "WaterPoloBoard.xcodeproj",
      team_id: team_id,
      bundle_identifier: "com.waterpolo.tacticalboard",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      profile_uuid: lane_context[SharedValues::SIGH_UUID]
    )

    build_app(
      project: "WaterPoloBoard.xcodeproj",
      scheme: "WaterPoloBoard",
      export_method: "app-store",
      clean: true,
      output_directory: "../build_output",
      output_name: "WaterPoloBoard.ipa",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          "com.waterpolo.tacticalboard" => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "../build_output/WaterPoloBoard.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
