<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>WaterPoloBoard</AssemblyName>
    <RootNamespace>WaterPoloBoard</RootNamespace>
    <Title>Waterpolo Tactical Board</Title>
    <Product>Waterpolo Tactical Board</Product>
    <Company>Water Polo Board</Company>
    <Copyright>Copyright © 2026</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <Target Name="ExcludeWpfFromBundle" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <FilesToBundle Remove="@(FilesToBundle)" 
        Condition="$([System.String]::Copy('%(FileName)').StartsWith('Presentation')) 
                   or '%(FileName)' == 'WindowsBase' 
                   or '%(FileName)' == 'wpfgfx_cor3' 
                   or '%(FileName)' == 'D3DCompiler_47_cor3' 
                   or '%(FileName)' == 'ReachFramework' 
                   or '%(FileName)' == 'System.Printing' 
                   or '%(FileName)' == 'System.Windows.Forms.Design'
                   or $([System.String]::Copy('%(FileName)').StartsWith('UIAutomation'))
                   or '%(FileName)' == 'DirectWriteForwarder'
                   or '%(FileName)' == 'System.Xaml'
                   or '%(FileName)' == 'System.Windows.Controls.Ribbon'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="EmbeddedAssets\**\*" />
  </ItemGroup>

</Project>
